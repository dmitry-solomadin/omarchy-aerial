#!/usr/bin/env bash
# Renders the plugin offscreen with Omarchy's real Commons and Ui and the current
# theme: tests/render/run [folder for the pictures]. It uses a throwaway home, so
# it can't touch real clips or settings, and it opens no window on the desktop.
set -euo pipefail
repo="$(cd -- "$(dirname -- "$0")/../.." && pwd)"
shell_root="${OMARCHY_PATH:-/usr/share/omarchy}/shell"
sandbox="$(mktemp -d)"
trap 'rm -rf -- "$sandbox"' EXIT
shots="${1:-$sandbox/shots}"
mkdir -p "$shots" "$sandbox/root" "$sandbox/data/aerial/videos" "$sandbox/cache/aerial/thumbnails" "$sandbox/config/aerial"

ln -s "$shell_root/Commons" "$sandbox/root/Commons"
ln -s "$shell_root/Ui" "$sandbox/root/Ui"
ln -s "$repo/qml" "$sandbox/root/Plugin"
cp "$repo/tests/render/shell.qml" "$sandbox/root/shell.qml"

# Real catalogue and thumbnails if this machine has them, and empty files for clips.
catalog="${XDG_DATA_HOME:-$HOME/.local/share}/aerial/catalog.json"
[[ -f $catalog ]] && cp "$catalog" "$sandbox/data/aerial/"
find "${XDG_CACHE_HOME:-$HOME/.cache}/aerial/thumbnails" -maxdepth 1 -type f -exec cp -t "$sandbox/cache/aerial/thumbnails" {} + 2>/dev/null || true
jq -r '.clips | keys[]' "$sandbox/data/aerial/catalog.json" 2>/dev/null | sed -n '1~5p' | while read -r clip; do
  printf x >"$sandbox/data/aerial/videos/$clip"
done

status=0
: >"$sandbox/log"
for short in 0 1; do
  SHORT="$short" SHOTS="$shots" AERIAL_REAL_CLI="$repo/bin/aerial" AERIAL_CLI="$repo/tests/render/fake-aerial" \
    XDG_DATA_HOME="$sandbox/data" XDG_CACHE_HOME="$sandbox/cache" XDG_CONFIG_HOME="$sandbox/config" XDG_STATE_HOME="$sandbox/state" \
    QT_QPA_PLATFORM=offscreen QT_QUICK_BACKEND=software \
    timeout 60 quickshell -n -p "$sandbox/root/shell.qml" >>"$sandbox/log" 2>&1 || status=$?
done
sed -E 's/\x1b\[[0-9;]*m//g' "$sandbox/log" | grep -E 'shot |hover |fits |@file:|\.qml\[|TypeError|ReferenceError|Cannot |is not a ' || true
[[ $# -gt 0 ]] && echo "Pictures in $shots"
exit "$status"
